# Server-side only. Never expose this with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional overrides
OPENAI_FEEDBACK_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Reasoning effort for feedback: minimal | low | medium | high. Defaults to high.
# Unknown values fall back to the default. Higher effort costs more and answers slower.
OPENAI_FEEDBACK_EFFORT=high
