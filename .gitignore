# --- Local tooling / agent scratch ---
# Browser- and Playwright-driven verification runs write here. These are
# machine-local evidence, never source, so they must not reach a PR diff.
/output/
/.playwright-cli/
/.playwright-mcp/
/playwright-report/
/test-results/
/.claude/*
!/.claude/settings.json

# --- Editors & OS ---
